# MongoDB connection string. If MongoDB isn't reachable at startup, the
# server logs a warning and runs in-memory only — rooms still work in
# real time, they just won't survive a restart or emptying out.
#
# Local MongoDB:      mongodb://localhost:27017/syncspace
# MongoDB Atlas (free tier): get this from your Atlas cluster's "Connect"
# button — looks like mongodb+srv://user:pass@cluster.mongodb.net/syncspace
MONGODB_URI=mongodb://localhost:27017/syncspace

# Secret used to sign login tokens (JWTs). Required — the server refuses
# to start without this set. Use a long, random, unguessable string.
# NEVER commit a real value of this to git.
JWT_SECRET=change-this-to-a-long-random-string-before-running